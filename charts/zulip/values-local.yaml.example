## 1. Replace each occurrence of "set-secure-password" with a different
##    random password and uncomment it.
## 2. Replace each occurrence of "zulip.example.com" with the domain you want
##    Zulip to be reached on.

zulip:
  settings:
    externalHost: zulip.example.com
    administratorEmail: admin@example.com
  secrets:
    secretKey: set-secure-secret-key
    sharedSecret: set-secure-shared-secret
    avatarSalt: set-secure-avatar-salt
  ## Object storage is the durable upload backend for horizontally scaled Zulip.
  # objectStorage:
  #   enabled: true
  #   uploadsBucket: zulip-uploads
  #   avatarBucket: zulip-avatars
  #   endpointUrl: https://s3.example.com
  #   region: us-east-1
  #   addressingStyle: path
  #   accessKey: set-secure-s3-access-key
  #   secretKey: set-secure-s3-secret-key

web:
  ingress:
    enabled: true
    className: traefik
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-prod
    hosts:
      - host: zulip.example.com
        paths:
          - path: /
    tls:
      - secretName: zulip-tls
        hosts:
          - zulip.example.com

memcached:
  # memcachedPassword: set-secure-password

rabbitmq:
  # The RabbitMQ operator creates <rabbitmq.name>-default-user by default.
  # defaultUserSecret: my-rabbitmq-default-user

redis:
  auth:
    # password: set-secure-password

cnpg:
  auth:
    ## CNPG can generate the application user password, or you can set one.
    # password: set-secure-password
